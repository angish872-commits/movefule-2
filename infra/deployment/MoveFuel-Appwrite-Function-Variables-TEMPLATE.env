# Set these in the Appwrite Function console or CLI; do not copy this template
# to an Android module and do not commit a populated version.
MOVEFUEL_ENV=production
MOVEFUEL_RUNTIME=appwrite-functions
MOVEFUEL_AUTH_MODE=appwrite
APPWRITE_ENDPOINT=https://REPLACE_WITH_EU_REGION.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
APPWRITE_DATABASE_ID=movefuel_mvp
FUNCTION_API_ID=movefuel_api
BUCKET_MEAL_MEDIA_ID=meal-history-private
OPENROUTER_API_KEY=REPLACE_ME
OPENROUTER_FOOD_VISION_MODEL=REPLACE_WITH_OPENROUTER_VISION_MODEL_ID
OPENROUTER_FOOD_VISION_TIMEOUT_MS=30000
OPENROUTER_APP_NAME=MoveFuel
# Optional canonical public app URL used only as OpenRouter attribution metadata.
OPENROUTER_APP_URL=
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-3.6-flash
USDA_FDC_API_KEY=
OPEN_FOOD_FACTS_USER_AGENT=MoveFuel/1.0 (configure-a-contact)

# Public camera estimates stay off until signed validation evidence exists.
MOVEFUEL_CAMERA_PUBLIC_ENABLED=false
MOVEFUEL_CAMERA_VALIDATION_ARTIFACT=
MOVEFUEL_KNOWLEDGE_SNAPSHOT=
MOVEFUEL_PORTION_CALIBRATION_PROFILES=

# Paid features are intentionally unavailable for the first public release.
MOVEFUEL_PAID_FEATURES_ENABLED=false
MOVEFUEL_PUBLIC_NUTRITION_ACCURACY_CLAIM=
