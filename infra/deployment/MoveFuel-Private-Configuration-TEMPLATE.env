# Copy to a private .env file on the backend machine.
# Never commit this file with real secrets and never place it in Android or Wear source.

MOVEFUEL_ENV=local
MOVEFUEL_AUTH_MODE=appwrite
MOVEFUEL_HOST=127.0.0.1
PORT=8787

APPWRITE_ENDPOINT=replace-with-appwrite-endpoint
APPWRITE_PROJECT_ID=replace-with-appwrite-project-id
APPWRITE_DATABASE_ID=movefuel_mvp

# Server/migration only. Keep these out of APKs, ZIPs shared with engineers, logs, and chat.
APPWRITE_API_KEY=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME
OPENROUTER_FOOD_VISION_MODEL=REPLACE_WITH_OPENROUTER_VISION_MODEL_ID
OPENROUTER_FOOD_VISION_TIMEOUT_MS=30000
OPENROUTER_APP_NAME=MoveFuel
# Optional canonical public app URL used only as OpenRouter attribution metadata.
OPENROUTER_APP_URL=
USDA_FDC_API_KEY=
OPEN_FOOD_FACTS_USER_AGENT=MoveFuel/1.0 (configure-a-contact)
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-3.6-flash

# Reviewed nutrition-algorithm release artifacts.
MOVEFUEL_KNOWLEDGE_SNAPSHOT=
MOVEFUEL_PORTION_CALIBRATION_PROFILES=
MOVEFUEL_REVIEWED_RECIPE_SNAPSHOT=
MOVEFUEL_CAMERA_VALIDATION_ARTIFACT=
MOVEFUEL_CAMERA_PUBLIC_ENABLED=false

# Populate from the reviewed Appwrite manifest after the live dry-run.
# Reviewed snapshot = 77 tables; the four approved additive migrations bring the
# frozen deployment target to exactly 81 tables. This manifest remains the logical catalogue.
TABLE_MANIFEST_PATH=services/backend/migrations/full-spec-manifest.v1.json

# Add only after Appwrite Console resources are confirmed.
BUCKET_MEAL_MEDIA_ID=meal-history-private
BUCKET_EXPORT_ARTIFACTS_ID=REPLACE_ME
FUNCTION_API_ID=movefuel_api
