{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "movefuel/schemas/benchmark/benchmark-manifest.schema.json",
  "title": "BenchmarkManifest",
  "type": "object",
  "required": ["manifestVersion", "name", "status", "totalPlannedSamples", "categories", "samples"],
  "properties": {
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PLANNED", "COLLECTING", "REVIEWED", "EVALUATED"] },
    "totalPlannedSamples": { "type": "integer", "minimum": 1 },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "count", "sampleIds"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 1 },
          "sampleIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "benchmark-sample.schema.json" }
    }
  }
}
